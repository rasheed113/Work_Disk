rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function own(value) {
      return signedIn() && value == request.auth.uid;
    }

    function participant(data) {
      return signedIn() && request.auth.uid in data.participantIds;
    }

    match /profiles/{userId} {
      allow read: if own(userId);
      allow create: if own(userId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
      allow update: if own(userId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.wdId == resource.data.wdId
        && request.resource.data.email == request.auth.token.email;
      allow delete: if false;
    }

    match /posts/{postId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.likeCount == 0
        && request.resource.data.audience == 'authenticated';

      allow update: if signedIn()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && (
          (
            request.resource.data.content == resource.data.content
            && request.resource.data.audience == resource.data.audience
            && request.resource.data.likeCount == resource.data.likeCount + 1
            && getAfter(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid)).data.actorId == request.auth.uid
          )
          || (
            request.resource.data.likeCount == resource.data.likeCount
          )
        );

      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;

      match /likes/{userId} {
        allow read: if signedIn();
        allow create: if own(userId)
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.postId == postId
          && !exists(/databases/$(database)/documents/posts/$(postId)/likes/$(userId));
        allow delete: if own(userId);
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.authorId == request.auth.uid;
        allow update: if signedIn()
          && resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId;
        allow delete: if signedIn()
          && (
            resource.data.authorId == request.auth.uid
            || get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid
          );
      }
    }

    match /activities/{activityId} {
      allow read: if signedIn() && resource.data.actorId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.type == 'like'
        && request.resource.data.targetPostId is string
        && getAfter(/databases/$(database)/documents/posts/$(request.resource.data.targetPostId)/likes/$(request.auth.uid)).data.actorId == request.auth.uid;
      allow update, delete: if false;
    }

    match /videos/{videoId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId;
    }

    match /media/{mediaId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow read: if signedIn()
        && resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
    }

    match /conversations/{conversationId} {
      allow create: if participant(request.resource.data);
      allow read, update: if participant(resource.data);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if participant(get(/databases/$(database)/documents/conversations/$(conversationId)).data);
        allow create: if participant(get(/databases/$(database)/documents/conversations/$(conversationId)).data)
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if participant(get(/databases/$(database)/documents/conversations/$(conversationId)).data)
          && resource.data.senderId == request.auth.uid;
      }
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if signedIn()
        && resource.data.recipientId == request.auth.uid;
      allow create: if false;
    }

    match /callSessions/{callId} {
      allow create: if participant(request.resource.data);
      allow read, update: if participant(resource.data);
      allow delete: if false;
    }

    match /relationships/{relationshipId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && (
          request.resource.data.followerId == request.auth.uid
          || request.resource.data.followingId == request.auth.uid
        );
      allow update, delete: if signedIn()
        && (
          resource.data.followerId == request.auth.uid
          || resource.data.followingId == request.auth.uid
        );
    }

    match /comments/{commentId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.authorId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
